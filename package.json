{
  "name": "fast-alpr-node",
  "version": "0.1.0",
  "description": "Port of fast-alpr (Automatic License Plate Recognition) to Node.js using ONNX Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predict": "tsx examples/predict.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adalbertorsilva/fast-alpr-node.git"
  },
  "bugs": {
    "url": "https://github.com/adalbertorsilva/fast-alpr-node/issues"
  },
  "homepage": "https://github.com/adalbertorsilva/fast-alpr-node#readme",
  "keywords": [
    "alpr",
    "anpr",
    "license-plate",
    "ocr",
    "onnx",
    "computer-vision"
  ],
  "dependencies": {
    "@techstark/opencv-js": "^4.10.0-release.1",
    "onnxruntime-node": "^1.20.0",
    "sharp": "^0.33.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
